# UAVCrew MCP Gateway Configuration
# Copy this file to .env and customize for your environment.
#
# Auth: JWT + Dynamic Resolver (multi-tenant)
#   UAVCrew sends T1 delegation JWTs (signed with K2).
#   Gateway validates with K3 public key, then resolves K4
#   per-tenant via the client's resolver endpoint.
#   See AUTH_DECISION.md for the full key/token reference.

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Path to K3 public key (PEM) for validating T1 delegation JWTs from UAVCrew.
# Generate with: python manage.py generate_delegation_keypair (on UAVCrew)
MCP_JWT_PUBLIC_KEY_PATH=/opt/ayna/uavcrew-mcp-server/keys/k3_public.pem

# =============================================================================
# CLIENT API
# =============================================================================
# Base URL of the client REST API that the gateway forwards requests to.
# The gateway appends entity paths from manifest.json to this URL.
# If not set, falls back to api_base_url in manifest.json.
CLIENT_API_BASE_URL=https://app.ayna.com/api/v1

# =============================================================================
# SERVER
# =============================================================================
# Server identity (shown in UAVCrew dashboard)
MCP_SERVER_NAME=MCP Gateway

# Public HTTPS URL where UAVCrew connects (behind reverse proxy)
MCP_PUBLIC_URL=https://mcp.example.com

# Host to bind to (127.0.0.1 recommended — behind reverse proxy)
MCP_HOST=127.0.0.1

# Port to listen on
MCP_PORT=8400

# =============================================================================
# MANIFEST
# =============================================================================
# Path to manifest.json. Defaults to ./manifest.json if not set.
MCP_MANIFEST_PATH=./manifest.json

# =============================================================================
# STORAGE (MinIO / S3-compatible) — for artifact entity file operations
# =============================================================================
# MINIO_ENDPOINT_URL=https://minio.example.com
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET_PREFIX=

# =============================================================================
# LOGGING
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
